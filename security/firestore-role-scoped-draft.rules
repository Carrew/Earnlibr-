rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Set this claim only with a trusted Firebase Admin SDK / privileged server.
    // Existing admins/{uid} documents and users/{uid}.role are NOT authority.
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /admins/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, delete: if false;
      // Login compatibility only; cannot change roles or identity.
      allow update: if owner(uid)
                    && onlyChanged(['lastLoginAt'])
                    && request.resource.data.lastLoginAt == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      // Signup creates users/{uid} and referralCodes/{code} atomically.
      allow create: if owner(uid)
                    && request.resource.data.keys().hasOnly(['uid','name','email','role','country','phone','referralCode','referredBy','fcmTokens','lastLoginAt','updatedAt','createdAt'])
                    && request.resource.data.keys().hasAll(['uid','name','email','role','country','phone','referralCode','fcmTokens','lastLoginAt','updatedAt','createdAt'])
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role in ['provider','freelancer','promoter']
                    && request.resource.data.referralCode is string
                    && request.resource.data.referralCode.size() >= 4
                    && request.resource.data.referralCode.size() <= 64
                    && request.resource.data.fcmTokens == []
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.lastLoginAt == request.time
                    && existsAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode))
                    && getAfter(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.ownerUid == uid;
      allow update: if admin()
                    && onlyChanged(['disabled', 'role'])
                    && (!request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role in ['provider', 'freelancer', 'promoter']);
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow get, list: if admin();
      allow update: if admin() && onlyChanged(['read'])
                    && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /platform-settings/{settingId} {
      allow get, list: if admin();
      // Commission configuration writes should migrate to verified backend.
      allow create, update, delete: if false;
    }

    match /providers/{providerId}/offers/{offerId} {
      allow get, list: if admin() || owner(providerId);
      allow create, update, delete: if false;
    }
    match /completed-deals/{dealId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /bills/{billId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /providers/{providerId}/bills/{billId} {
      allow get, list: if admin() || owner(providerId);
      allow create, update, delete: if false;
    }
    match /notifications/{uid}/items/{notificationId} {
      allow get, list: if admin() || owner(uid);
      allow update: if owner(uid)
                    && onlyChanged(['read'])
                    && request.resource.data.read == true;
      allow create, delete: if false;
    }


    // Provider pending offers: query MUST filter providerId == request.auth.uid.
    match /offers_pending/{offerId} {
      allow get: if admin() || (signedIn() && resource.data.providerId == request.auth.uid);
      allow list: if admin() || (signedIn() && resource.data.providerId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.providerId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['providerId','title','description','category','currency','price','commissionType','commissionValue','promotionBudget','totalProducts','imageTemp','status','createdAt'])
                    && request.resource.data.keys().hasAll(['providerId','title','description','category','currency','price','commissionType','commissionValue','promotionBudget','totalProducts','status','createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 180
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0
                    && request.resource.data.commissionValue is number
                    && request.resource.data.commissionValue >= 0
                    && request.resource.data.promotionBudget is number
                    && request.resource.data.promotionBudget >= 0
                    && request.resource.data.totalProducts is int
                    && request.resource.data.totalProducts >= 0;
      allow update, delete: if false;
    }

    // NOTE: current frontend reads all offers then filters locally. This may expose
    // pending/paused records. Migrate to a status-scoped query before publishing.
    // Promoters may browse approved active offers; publishing stays server-owned.
    match /offers_all/{offerId} {
      // Both direct document reads and collection queries require active status.
      // Queries must include where('status', '==', 'active').
      allow get, list: if signedIn() && resource.data.status == 'active';
      allow create, update, delete: if false;
    }

    // Only the promoter can view and save their own selected offers.
    match /promoter_offers/{promoterId}/offers/{offerId} {
      allow get, list: if admin() || owner(promoterId);
      // Snapshot creation is permitted only if it exactly reflects an approved offer.
      // Existing merge writes remain blocked: they can modify tracking/commission data.
      function sourceOffer() {
        return get(/databases/$(database)/documents/offers_all/$(offerId)).data;
      }
      allow create: if owner(promoterId)
                    && exists(/databases/$(database)/documents/offers_all/$(offerId))
                    && sourceOffer().get('status', '') == 'active'
                    && sourceOffer().get('verified', false) == true
                    && request.resource.data.keys().hasOnly(['offerId','promoterId','title','description','imageUrl','category','currency','price','commissionValue','commissionType','status','clicks','lastClickAt','createdAt','startedPromotingAt','lastShareAt'])
                    && request.resource.data.keys().hasAll(['offerId','promoterId','title','description','imageUrl','category','currency','price','commissionValue','commissionType','status','clicks','lastClickAt','createdAt','startedPromotingAt','lastShareAt'])
                    && request.resource.data.offerId == offerId
                    && request.resource.data.promoterId == promoterId
                    && request.resource.data.title == sourceOffer().get('title', 'Untitled Offer')
                    && request.resource.data.description == sourceOffer().get('description', '')
                    && request.resource.data.imageUrl == sourceOffer().get('imageUrl', '')
                    && request.resource.data.category == sourceOffer().get('category', '')
                    && request.resource.data.currency == sourceOffer().get('currency', '
      // Stats, earnings and performance are server-owned.
      allow update, delete: if false;
    }

    // Provider deal queries MUST filter providerId == auth.uid.
    // Promoter/client reads must be similarly constrained by their identity.
    match /deals/{dealId} {
      allow get, list: if admin() ||
        (signedIn() && (
          resource.data.providerId == request.auth.uid ||
          resource.data.promoterId == request.auth.uid ||
          resource.data.get('clientAuthUid', '') == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    // Chat participants can read only their own chat, with constrained queries.
    match /chats/{chatId} {
      allow get, list: if admin() ||
        (signedIn() && (
          resource.data.providerId == request.auth.uid ||
          resource.data.get('participants', {}).get('clientAuthUid', '') == request.auth.uid
        ));
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function chatAllowed() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId));
          return admin() || (signedIn() && (
            chat.data.providerId == request.auth.uid ||
            chat.data.get('participants', {}).get('clientAuthUid', '') == request.auth.uid
          ));
        }
        allow get, list: if chatAllowed();
        allow create, update, delete: if false;
      }
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }

    // Fail closed for every other document. NOT suitable for production
    // until promoter/provider/signup workflows are mapped and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
                    && request.resource.data.price == sourceOffer().get('price', null)
                    && request.resource.data.commissionValue == sourceOffer().get('commissionValue', 0)
                    && request.resource.data.commissionType == sourceOffer().get('commissionType', 'flat')
                    && request.resource.data.status == 'active'
                    && request.resource.data.clicks == 0
                    && request.resource.data.lastClickAt == null
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.startedPromotingAt is timestamp
                    && request.resource.data.lastShareAt is timestamp;
      // Stats, earnings and performance are server-owned.
      allow update, delete: if false;
    }

    // Provider deal queries MUST filter providerId == auth.uid.
    // Promoter/client reads must be similarly constrained by their identity.
    match /deals/{dealId} {
      allow get, list: if admin() ||
        (signedIn() && (
          resource.data.providerId == request.auth.uid ||
          resource.data.promoterId == request.auth.uid ||
          resource.data.get('clientAuthUid', '') == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    // Chat participants can read only their own chat, with constrained queries.
    match /chats/{chatId} {
      allow get, list: if admin() ||
        (signedIn() && (
          resource.data.providerId == request.auth.uid ||
          resource.data.get('participants', {}).get('clientAuthUid', '') == request.auth.uid
        ));
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function chatAllowed() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId));
          return admin() || (signedIn() && (
            chat.data.providerId == request.auth.uid ||
            chat.data.get('participants', {}).get('clientAuthUid', '') == request.auth.uid
          ));
        }
        allow get, list: if chatAllowed();
        allow create, update, delete: if false;
      }
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['ownerUid'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }

    // Fail closed for every other document. NOT suitable for production
    // until promoter/provider/signup workflows are mapped and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
