rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Set this claim only with a trusted Firebase Admin SDK / privileged server.
    // Existing admins/{uid} documents and users/{uid}.role are NOT authority.
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /admins/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create, delete: if false;
      // Login compatibility only; cannot change roles or identity.
      allow update: if owner(uid)
                    && onlyChanged(['lastLoginAt'])
                    && request.resource.data.lastLoginAt == request.time;
    }

    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      // Client signup currently creates users and referralCodes in a batch;
      // do not enable broad create here without inspecting its schema.
      allow create: if false;
      allow update: if admin()
                    && onlyChanged(['disabled', 'role'])
                    && (!request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role in ['provider', 'freelancer', 'promoter']);
      allow delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow get, list: if admin();
      allow update: if admin() && onlyChanged(['read'])
                    && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /platform-settings/{settingId} {
      allow get, list: if admin();
      // Commission configuration writes should migrate to verified backend.
      allow create, update, delete: if false;
    }

    match /offers_pending/{offerId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /offers_all/{offerId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /providers/{providerId}/offers/{offerId} {
      allow get, list: if admin() || owner(providerId);
      allow create, update, delete: if false;
    }
    match /deals/{dealId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /completed-deals/{dealId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /chats/{chatId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /bills/{billId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    match /providers/{providerId}/bills/{billId} {
      allow get, list: if admin() || owner(providerId);
      allow create, update, delete: if false;
    }
    match /notifications/{uid}/items/{notificationId} {
      allow get, list: if admin() || owner(uid);
      allow update: if owner(uid)
                    && onlyChanged(['read'])
                    && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // Fail closed for every other document. NOT suitable for production
    // until promoter/provider/signup workflows are mapped and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
