rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Administrative authority must be provisioned by a trusted backend,
    // never inferred from user-editable role fields or localStorage.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // Intentionally block client-side creation until signup is migrated
      // to a trusted server endpoint with validated role assignment.
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // All remaining collections, including deals, chats, bills,
    // offers, payouts, and notifications, are private until
    // their server-verified authorization flows are migrated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
